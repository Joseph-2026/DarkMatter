{
  "$schema": "https://github.com/Joseph-2026/DarkMatter/desktop-theme.json",
  "name": "Dark Matter",
  "id": "darkmatter",
  "light": {
    "palette": {
      "neutral": "#f0f0f0",
      "ink": "#18181b",
      "primary": "#0ea5e9",
      "accent": "#7dd3fc",
      "success": "#34d399",
      "warning": "#fbbf24",
      "error": "#f87171",
      "info": "#60a5fa",
      "diffAdd": "#22c55e",
      "diffDelete": "#f87171"
    },
    "overrides": {
      "syntax-comment": "#6b7280",
      "syntax-keyword": "#0ea5e9",
      "syntax-string": "#16a34a",
      "syntax-primitive": "#059669",
      "syntax-property": "#0ea5e9",
      "syntax-constant": "#0ea5e9"
    }
  },
  "dark": {
    "palette": {
      "neutral": "#0f0f0f",
      "ink": "#e5e5e7",
      "primary": "#0891b2",
      "accent": "#38bdf8",
      "success": "#10b981",
      "warning": "#f59e0b",
      "error": "#f87171",
      "info": "#3b82f6",
      "diffAdd": "#059669",
      "diffDelete": "#f87171"
    },
    "overrides": {
      "syntax-comment": "#6b7280",
      "syntax-keyword": "#3b82f6",
      "syntax-string": "#10b981",
      "syntax-primitive": "#0891b2",
      "syntax-property": "#3b82f6",
      "syntax-constant": "#3b82f6"
    }
  }
}